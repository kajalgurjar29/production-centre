generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMINISTRATOR
  CONTENT_ADMIN
  MODERATOR
  FINANCE_ADMIN
  READONLY_AUDITOR
}

enum AdminStatus {
  ACTIVE
  DEACTIVATED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AdvertStatus {
  DRAFT
  PAYMENT_REQUIRED
  PENDING_REVIEW
  AMENDMENTS_REQUIRED
  APPROVED
  ACTIVE
  PAUSED
  EXPIRED
  REMOVED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AiLeadStatus {
  NEW
  CONTACTED
  CLOSED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  INACTIVE
}

enum QuestionStatus {
  NEW
  REVIEWED
  RESOLVED
}

enum UserTitle {
  ALHAJA
  ALHAJI
  CHIEF
  DR
  ENGR
  LADY
  MALAM
  MISS
  MR
  MRS
  MS
  PROF
  PST
  REV
  SIR
}

enum NewsStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum HomepageBlockKey {
  HERO
  FEATURED
  TESTIMONIALS
  CTA
}

enum NotificationAudience {
  ALL_USERS
  ADVERTISERS
  ADMINISTRATORS
}

enum NotificationStatus {
  SENT
  FAILED
}

model AdminUser {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         AdminRole   @default(READONLY_AUDITOR)
  status       AdminStatus @default(ACTIVE)
  lastActiveAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  auditLogs     AuditLog[]
  notifications Notification[]

  @@map("appcentre_admin_users")
}

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  status            UserStatus @default(ACTIVE)
  title             UserTitle?
  firstName         String?
  surname           String?
  sex               String?
  city              String?
  country            String?
  displayPictureUrl String?
  otpCodeHash       String?
  otpExpiresAt      DateTime?
  otpVerifiedAt     DateTime?
  profileComplete   Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  adverts Advert[]

  @@map("appcentre_users")
}

model Site {
  id                    String   @id @default(cuid())
  siteKey               String   @unique
  siteName              String
  supportEmail          String
  logoUrl               String?
  approvedDomain        String?
  senderName            String?
  senderEmail           String?
  autoReplyEnabled      Boolean  @default(true)
  active                Boolean  @default(true)
  contactEnabled        Boolean  @default(true)
  reviewsEnabled        Boolean  @default(true)
  aiHelpEnabled         Boolean  @default(true)
  advertsEnabled        Boolean  @default(false)
  newsEnabled           Boolean  @default(false)
  notificationsEnabled  Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  adverts             Advert[]
  reviews             Review[]
  enquiries           ContactEnquiry[]
  aiAssistantLeads    AiAssistantLead[]
  knowledgeArticles   KnowledgeArticle[]
  unansweredQuestions UnansweredQuestion[]
  news                News[]
  homepageBlocks      HomepageBlock[]
  notifications       Notification[]

  @@map("appcentre_sites")
}

model Advert {
  id              String       @id @default(cuid())
  reference       String       @unique
  sequenceNumber  Int          @default(autoincrement())
  title           String
  description     String?
  type            String
  placement       String
  topic           String?
  status          AdvertStatus @default(DRAFT)
  paymentStatus   PaymentStatus @default(PENDING)
  sponsored       Boolean      @default(false)
  country         String?
  region          String?
  city            String?
  imageUrl        String?
  croppedImageUrl String?
  aiReviewNote    String?
  durationDays    Int?
  totalCost       Decimal?     @db.Decimal(10, 2)
  likeCount       Int          @default(0)
  reportCount     Int          @default(0)
  startDate       DateTime?
  endDate         DateTime?
  views           Int          @default(0)
  clicks          Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  advertiserId String
  advertiser   User      @relation(fields: [advertiserId], references: [id])
  payments     Payment[]

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@map("appcentre_adverts")
}

model Payment {
  id              String        @id @default(cuid())
  transactionRef  String        @unique
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("GBP")
  provider        String
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  advertId String
  advert   Advert @relation(fields: [advertId], references: [id])

  @@map("appcentre_payments")
}

model Review {
  id             String       @id @default(cuid())
  sequenceNumber Int          @default(autoincrement())
  name           String
  rating         Int
  topic          String?
  details        String?
  country        String?
  city           String?
  imageUrl       String?
  source         String       @default("AI Transformation")
  likeCount      Int          @default(0)
  reportCount    Int          @default(0)
  status         ReviewStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@map("appcentre_reviews")
}

model ContactEnquiry {
  id             String        @id @default(cuid())
  sequenceNumber Int           @default(autoincrement())
  title          String?
  firstName      String?
  lastName       String?
  name           String
  email          String
  country        String?
  city           String?
  enquiryType    String?
  subject        String
  message        String
  source         String?
  status         EnquiryStatus @default(NEW)
  createdAt      DateTime      @default(now())

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@map("appcentre_contact_enquiries")
}

model AiAssistantLead {
  id             String       @id @default(cuid())
  sequenceNumber Int          @default(autoincrement())
  firstName      String
  lastName       String
  email          String?
  sessionId      String?
  status         AiLeadStatus @default(NEW)
  createdAt      DateTime     @default(now())

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@map("appcentre_ai_assistant_leads")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  target    String?
  reason    String?
  createdAt DateTime @default(now())

  actorId String?
  actor   AdminUser? @relation(fields: [actorId], references: [id])

  @@map("appcentre_audit_log")
}

model KnowledgeArticle {
  id        String        @id @default(cuid())
  title     String
  category  String
  answer    String
  keywords  String        @default("")
  status    ArticleStatus @default(DRAFT)
  updatedBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  questions UnansweredQuestion[]

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@map("appcentre_knowledge_articles")
}

model UnansweredQuestion {
  id        String         @id @default(cuid())
  question  String
  sessionId String
  status    QuestionStatus @default(NEW)
  createdAt DateTime       @default(now())

  articleId String?
  article   KnowledgeArticle? @relation(fields: [articleId], references: [id])

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@map("appcentre_unanswered_questions")
}

model News {
  id         String     @id @default(cuid())
  title      String
  summary    String?
  body       String
  imageUrl   String?
  status     NewsStatus @default(DRAFT)
  featured   Boolean    @default(false)
  publishAt  DateTime?
  likeCount  Int        @default(0)
  shareCount Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@map("appcentre_news")
}

model HomepageBlock {
  id        String           @id @default(cuid())
  key       HomepageBlockKey
  headline  String?
  subtext   String?
  ctaLabel  String?
  published Boolean          @default(true)
  updatedBy String?
  updatedAt DateTime         @updatedAt

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, key])
  @@map("appcentre_homepage_blocks")
}

model Notification {
  id             String                @id @default(cuid())
  audience       NotificationAudience
  title          String
  message        String
  status         NotificationStatus    @default(SENT)
  recipientCount Int                   @default(0)
  createdAt      DateTime              @default(now())

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("appcentre_notifications")
}
